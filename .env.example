# Copy values into your shell environment (Django does not read .env files automatically).
# Every variable is optional for local use.

# Demo mode: no model needed. Each office answers its sample inputs from pre-written results.
DEMO_MODE=false

# Delete all cases when the server starts. Set to false to keep them in db.sqlite3.
WIPE_ON_START=true

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_READ_TIMEOUT=180
OLLAMA_THINK=false
OLLAMA_NUM_CTX=8192

# Limits
MAX_STATEMENT_CHARS=6000
MAX_DOCUMENT_CHARS=12000
MAX_UPLOAD_BYTES=60000

# Django. The defaults suit local development. Set these before deploying anywhere.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
# Behind an HTTPS proxy (most hosts): your public origin, and the proxy flag.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_BEHIND_PROXY=false
